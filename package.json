{
  "name": "@geekvetica/source",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Geekvetica Paweł Wojciechowski",
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "build": "nx build nx-astro",
    "test": "nx test nx-astro",
    "test:e2e": "nx e2e nx-astro-e2e",
    "test:all": "nx run-many -t test && nx e2e nx-astro-e2e",
    "lint": "nx run-many -t lint --all",
    "lint:fix": "nx run-many -t lint --all --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "typecheck": "nx run-many -t build --all",
    "clean": "nx reset && rm -rf dist node_modules/.cache",
    "release": "nx release",
    "verify": "npm run format:check && npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@nx/devkit": "23.3.0",
    "astro": "^7.3.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/jest": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/plugin": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@swc/helpers": "0.5.23",
    "@types/jest": "^30.0.0",
    "@types/node": "25.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jest-util": "^30.5.1",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.6.0",
    "memfs": "^4.80.0",
    "nx": "23.3.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "verdaccio": "6.10.5"
  },
  "nx": {
    "includedScripts": []
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "provenance": "true"
  }
}
